@model StudyRoom.Models.StudySession

@{
    ViewData["Title"] = "Detaljer";
}

<h1>@Model.Subject</h1>

<dl class="row">
    <dt class="col-sm-3">Tema</dt>
    <dd class="col-sm-9">@Model.Topic</dd>

    <dt class="col-sm-3">Rom</dt>
    <dd class="col-sm-9">@Model.Room.Name (@Model.Room.Building, @Model.Room.RoomType)</dd>

    <dt class="col-sm-3">Start</dt>
    <dd class="col-sm-9">@Model.StartTime.ToString("dd.MM.yyyy HH:mm")</dd>

    <dt class="col-sm-3">Slutt</dt>
    <dd class="col-sm-9">@Model.EndTime.ToString("dd.MM.yyyy HH:mm")</dd>

    <dt class="col-sm-3">Vert</dt>
    <dd class="col-sm-9">@Model.Host.FirstName @Model.Host.LastName</dd>

    <dt class="col-sm-3">Maks deltakere</dt>
    <dd class="col-sm-9">@Model.MaxParticipants</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Tilbake til listen</a>
