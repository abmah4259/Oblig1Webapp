@model StudyRoom.Models.Room

@{
    ViewData["Title"] = "Nytt rom";
}

<h1>Legg til nytt rom</h1>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Building" class="control-label"></label>
        <select asp-for="Building" class="form-control" asp-items="Html.GetEnumSelectList<StudyRoom.Models.Building>()"></select>
    </div>

    <div class="form-group">
        <label asp-for="RoomType" class="control-label"></label>
        <select asp-for="RoomType" class="form-control" asp-items="Html.GetEnumSelectList<StudyRoom.Models.RoomType>()"></select>
    </div>

    <div class="form-group">
        <label asp-for="Capacity" class="control-label"></label>
        <input asp-for="Capacity" type="number" min="1" max="100" class="form-control" id="capacityInput" />
        <span asp-validation-for="Capacity" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Utstyr</label>
        @foreach (var eq in (IEnumerable<StudyRoom.Models.Equipment>)ViewBag.EquipmentOptions)
        {
            <div class="form-check">
                <input type="checkbox" class="form-check-input" name="selectedEquipment" value="@eq" id="eq_@eq" />
                <label class="form-check-label" for="eq_@eq">@eq</label>
            </div>
        }
    </div>

    <div class="form-group mt-3">
        <input type="submit" value="Opprett" class="btn btn-primary" id="submitBtn" />
    </div>
</form>

<a asp-action="Index">Tilbake til listen</a>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const capacityInput = document.getElementById('capacityInput');
        const submitBtn = document.getElementById('submitBtn');

        function validateCapacity() {
            const value = parseInt(capacityInput.value, 10);
            submitBtn.disabled = isNaN(value) || value < 1 || value > 100;
        }

        capacityInput.addEventListener('input', validateCapacity);
        validateCapacity();

        const roomTypeRules = @Html.Raw(ViewBag.RoomTypeRulesJson);
        const equipmentRules = @Html.Raw(ViewBag.EquipmentRulesJson);

        const buildingSelect = document.querySelector('select[name="Building"]');
        const roomTypeSelect = document.querySelector('select[name="RoomType"]');
        const equipmentCheckboxes = document.querySelectorAll('input[name="selectedEquipment"]');

        function filterRoomTypes() {
            const allowed = roomTypeRules[buildingSelect.value] || [];
            Array.from(roomTypeSelect.options).forEach(opt => {
                const isAllowed = allowed.includes(opt.value);
                opt.hidden = !isAllowed;
                opt.disabled = !isAllowed;
            });
            if (!allowed.includes(roomTypeSelect.value)) {
                roomTypeSelect.value = allowed[0] || '';
            }
            filterEquipment();
        }

        function filterEquipment() {
            const allowed = equipmentRules[roomTypeSelect.value] || [];
            equipmentCheckboxes.forEach(cb => {
                const isAllowed = allowed.includes(cb.value);
                cb.disabled = !isAllowed;
                if (!isAllowed) {
                    cb.checked = false;
                }
            });
        }

        buildingSelect.addEventListener('change', filterRoomTypes);
        roomTypeSelect.addEventListener('change', filterEquipment);
        filterRoomTypes();
    </script>
}